              Void,
              TableValue([("x", Boolean(false))]),
            ]),
          ),
          ("time", Timestamp(1704067200UL)),
        ]),
      ),
      ("delivery-mode", Octet(2)),
      ("priority", Octet(0)),
      ("correlation-id", ShortString("订单")),
      ("reply-to", ShortString("reply")),
      ("expiration", ShortString("60000")),
      ("message-id", ShortString("id-1")),
      ("timestamp", LongLong(9223372036854775809UL)),
      ("type", ShortString("test")),
      ("user-id", ShortString("guest")),
      ("app-id", ShortString("app")),
      ("cluster-id", ShortString("")),
    ],
  }
  let wire = b"\x02\x00\x01\x00\x00\x00\xe8\x00\x3c\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfc\x10\x61\x70\x70\x6c\x69\x63\x61\x74\x69\x6f\x6e\x2f\x6a\x73\x6f\x6e\x05\x75\x74\x66\x2d\x38\x00\x00\x00\x8d\x06\xe4\xb8\xad\xe6\x96\x87\x53\x00\x00\x00\x06\xe6\xb6\x88\xe6\x81\xaf\x06\x62\x69\x6e\x61\x72\x79\x78\x00\x00\x00\x02\x00\xff\x03\x79\x65\x73\x74\x01\x02\x6e\x6f\x74\x00\x03\x6d\x69\x6e\x49\x80\x00\x00\x00\x05\x6c\x61\x72\x67\x65\x6c\x00\x04\x00\x00\x00\x00\x00\x01\x07\x64\x65\x63\x69\x6d\x61\x6c\x44\x02\xff\xff\xfb\x2e\x07\x6e\x6f\x74\x68\x69\x6e\x67\x56\x05\x61\x72\x72\x61\x79\x41\x00\x00\x00\x1a\x49\x00\x00\x00\x01\x53\x00\x00\x00\x06\x6e\x65\x73\x74\x65\x64\x56\x46\x00\x00\x00\x04\x01\x78\x74\x00\x04\x74\x69\x6d\x65\x54\x00\x00\x00\x00\x65\x92\x00\x80\x02\x00\x06\xe8\xae\xa2\xe5\x8d\x95\x05\x72\x65\x70\x6c\x79\x05\x36\x30\x30\x30\x30\x04\x69\x64\x2d\x31\x80\x00\x00\x00\x00\x00\x00\x01\x04\x74\x65\x73\x74\x05\x67\x75\x65\x73\x74\x03\x61\x70\x70\x00\xce"
  assert_eq(header.encode(1).encode(), wire)
  let decoder = @amqp.Decoder::new()
  assert_eq(@amqp.BasicHeader::decode(decoder.feed(wire)[0]), header)
  decoder.finish()
}

///|
test "Pika shared field-table types independent bytes" {
  {
    let entries : Array[(String, @amqp.FieldValue)] = []
    let wire = b"\x00\x00\x00\x00"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      ("中文", LongString(b"\xe6\xb6\x88\xe6\x81\xaf")),
      ("binary", ByteArray(b"\x00\xff")),
      ("yes", Boolean(true)),
      ("no", Boolean(false)),
      ("min", Signed32(-2147483648)),
      ("large", Signed64(1125899906842625L)),
      ("decimal", Decimal(2, -1234)),
      ("nothing", Void),
      (
        "array",
        ArrayValue([
          Signed32(1),
          LongString(b"\x6e\x65\x73\x74\x65\x64"),
          Void,
          TableValue([("x", Boolean(false))]),
        ]),
      ),
      ("time", Timestamp(1704067200UL)),
    ]
    let wire = b"\x00\x00\x00\x8d\x06\xe4\xb8\xad\xe6\x96\x87\x53\x00\x00\x00\x06\xe6\xb6\x88\xe6\x81\xaf\x06\x62\x69\x6e\x61\x72\x79\x78\x00\x00\x00\x02\x00\xff\x03\x79\x65\x73\x74\x01\x02\x6e\x6f\x74\x00\x03\x6d\x69\x6e\x49\x80\x00\x00\x00\x05\x6c\x61\x72\x67\x65\x6c\x00\x04\x00\x00\x00\x00\x00\x01\x07\x64\x65\x63\x69\x6d\x61\x6c\x44\x02\xff\xff\xfb\x2e\x07\x6e\x6f\x74\x68\x69\x6e\x67\x56\x05\x61\x72\x72\x61\x79\x41\x00\x00\x00\x1a\x49\x00\x00\x00\x01\x53\x00\x00\x00\x06\x6e\x65\x73\x74\x65\x64\x56\x46\x00\x00\x00\x04\x01\x78\x74\x00\x04\x74\x69\x6d\x65\x54\x00\x00\x00\x00\x65\x92\x00\x80"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      ("中文", LongString(b"\xe6\xb6\x88\xe6\x81\xaf")),
    ]
    let wire = b"\x00\x00\x00\x12\x06\xe4\xb8\xad\xe6\x96\x87\x53\x00\x00\x00\x06\xe6\xb6\x88\xe6\x81\xaf"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      ("binary", ByteArray(b"\x00\xff")),
    ]
    let wire = b"\x00\x00\x00\x0e\x06\x62\x69\x6e\x61\x72\x79\x78\x00\x00\x00\x02\x00\xff"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [("yes", Boolean(true))]
    let wire = b"\x00\x00\x00\x06\x03\x79\x65\x73\x74\x01"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [("no", Boolean(false))]
    let wire = b"\x00\x00\x00\x05\x02\x6e\x6f\x74\x00"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      ("min", Signed32(-2147483648)),
    ]
    let wire = b"\x00\x00\x00\x09\x03\x6d\x69\x6e\x49\x80\x00\x00\x00"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      ("large", Signed64(1125899906842625L)),
    ]
    let wire = b"\x00\x00\x00\x0f\x05\x6c\x61\x72\x67\x65\x6c\x00\x04\x00\x00\x00\x00\x00\x01"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      ("decimal", Decimal(2, -1234)),
    ]
    let wire = b"\x00\x00\x00\x0e\x07\x64\x65\x63\x69\x6d\x61\x6c\x44\x02\xff\xff\xfb\x2e"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [("nothing", Void)]
    let wire = b"\x00\x00\x00\x09\x07\x6e\x6f\x74\x68\x69\x6e\x67\x56"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  {
    let entries : Array[(String, @amqp.FieldValue)] = [
      (
        "array",
        ArrayValue([
          Signed32(1),
          LongString(b"\x6e\x65\x73\x74\x65\x64"),
          Void,
          TableValue([("x", Boolean(false))]),
        ]),
      ),
    ]
    let wire = b"\x00\x00\x00\x25\x05\x61\x72\x72\x61\x79\x41\x00\x00\x00\x1a\x49\x00\x00\x00\x01\x53\x00\x00\x00\x06\x6e\x65\x73\x74\x65\x64\x56\x46\x00\x00\x00\x04\x01\x78\x74\x00"
    assert_eq(@amqp.encode_table(entries), wire)
    assert_eq(@amqp.decode_table(wire), entries)
  }
  let entries : Array[(String, @amqp.FieldValue)] = [
    ("time", Timestamp(1704067200UL)),
  ]
  let wire = b"\x00\x00\x00\x0e\x04\x74\x69\x6d\x65\x54\x00\x00\x00\x00\x65\x92\x00\x80"
  assert_eq(@amqp.encode_table(entries), wire)
  assert_eq(@amqp.decode_table(wire), entries)
}
