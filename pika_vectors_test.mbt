///|
test "Pika Basic properties all flags and individual presence" {
  {
    let header : @amqp.BasicHeader = {
      body_size: 18446744073709551615UL,
      properties: [],
    }
    let wire = b"\x02\x00\x01\x00\x00\x00\x0e\x00\x3c\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\xce"
    assert_eq(header.encode(1).encode(), wire)
    let decoder = @amqp.Decoder::new()
    assert_eq(@amqp.BasicHeader::decode(decoder.feed(wire)[0]), header)
    decoder.finish()
  }
  {
    let header : @amqp.BasicHeader = {
      body_size: 18446744073709551615UL,
      properties: [("content-type", ShortString("application/json"))],
    }
    let wire = b"\x02\x00\x01\x00\x00\x00\x1f\x00\x3c\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x80\x00\x10\x61\x70\x70\x6c\x69\x63\x61\x74\x69\x6f\x6e\x2f\x6a\x73\x6f\x6e\xce"
    assert_eq(header.encode(1).encode(), wire)
    let decoder = @amqp.Decoder::new()
    assert_eq(@amqp.BasicHeader::decode(decoder.feed(wire)[0]), header)
    decoder.finish()
  }
  {
    let header : @amqp.BasicHeader = {
      body_size: 18446744073709551615UL,
      properties: [("content-encoding", ShortString("utf-8"))],
    }
    let wire = b"\x02\x00\x01\x00\x00\x00\x14\x00\x3c\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x40\x00\x05\x75\x74\x66\x2d\x38\xce"
    assert_eq(header.encode(1).encode(), wire)
    let decoder = @amqp.Decoder::new()
    assert_eq(@amqp.BasicHeader::decode(decoder.feed(wire)[0]), header)
    decoder.finish()
  }
  {
    let header : @amqp.BasicHeader = {
      body_size: 18446744073709551615UL,
      properties: [
        (
          "headers",
          Table([
            ("中文", LongString(b"\xe6\xb6\x88\xe6\x81\xaf")),
            ("binary", ByteArray(b"\x00\xff")),
            ("yes", Boolean(true)),
            ("no", Boolean(false)),
            ("min", Signed32(-2147483648)),
            ("large", Signed64(1125899906842625L)),
            ("decimal", Decimal(2, -1234)),
            ("nothing", Void),
            (
              "array",
              ArrayValue([
                Signed32(1),
                LongString(b"\x6e\x65\x73\x74\x65\x64"),
                Void,
                TableValue([("x", Boolean(false))]),
              ]),
            ),
            ("time", Timestamp(1704067200UL)),
          ]),
        ),
      ],
    }
    let wire = b"\x02\x00\x01\x00\x00\x00\x9f\x00\x3c\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x20\x00\x00\x00\x00\x8d\x06\xe4\xb8\xad\xe6\x96\x87\x53\x00\x00\x00\x06\xe6\xb6\x88\xe6\x81\xaf\x06\x62\x69\x6e\x61\x72\x79\x78\x00\x00\x00\x02\x00\xff\x03\x79\x65\x73\x74\x01\x02\x6e\x6f\x74\x00\x03\x6d\x69\x6e\x49\x80\x00\x00\x00\x05\x6c\x61\x72\x67\x65\x6c\x00\x04\x00\x00\x00\x00\x00\x01\x07\x64\x65\x63\x69\x6d\x61\x6c\x44\x02\xff\xff\xfb\x2e\x07\x6e\x6f\x74\x68\x69\x6e\x67\x56\x05\x61\x72\x72\x61\x79\x41\x00\x00\x00\x1a\x49\x00\x00\x00\x01\x53\x00\x00\x00\x06\x6e\x65\x73\x74\x65\x64\x56\x46\x00\x00\x00\x04\x01\x78\x74\x00\x04\x74\x69\x6d\x65\x54\x00\x00\x00\x00\x65\x92\x00\x80\xce"
    assert_eq(header.encode(1).encode(), wire)
    let decoder = @amqp.Decoder::new()
    assert_eq(@amqp.BasicHeader::decode(decoder.feed(wire)[0]), header)
    decoder.finish()
  }
  {
    let header : @amqp.BasicHeader = {
      body_size: 18446744073709551615UL,
      properties: [("delivery-mode", Octet(2))],
    }
