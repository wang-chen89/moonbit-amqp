    assert_eq(
      auth_reply(s, b"X-BINARY").arguments[2],
      LongString(b"\x00\xff\x01\x78"),
    )
  }
  let s = Session::with_authentication([
    Authentication::custom("X-BINARY", b"\xe4\xb8\xad\xe5\xaf\x86"),
  ])
  assert_eq(
    auth_reply(s, b"X-BINARY").arguments[2],
    LongString(b"\xe4\xb8\xad\xe5\xaf\x86"),
  )
}
