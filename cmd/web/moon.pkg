import {
  "wang-chen89/amqp" @lib,
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "inspect_wire",
        "schemas",
        "uri_parse",
        "connection_properties",
        "default_connection_properties",
        "session_metadata",
        "session_open_auth_properties",
        "session_open",
        "session_open_auth",
        "session_open_stream_auth",
        "session_auth_response",
        "session_drop",
        "session_feed",
        "session_send",
        "session_publish",
        "session_publish_flags",
        "session_publish_start",
        "session_publish_start_flags",
        "session_publish_body",
        "session_heartbeat",
        "session_finish",
      ],
      "format": "esm",
    },
  },
)
